# PRIMARY host. OpenPak Xbox 360 message server (x360-msgserver): Live service 2 requests the security
# gateway tunnels to the primary's Traefik. Identity headers are trusted only with the gateway key.
[Unit]
Description=OpenPak Xbox 360 message server (x360-msgserver)

[Container]
ContainerName=openpak-x360-msgserver
Image=ghcr.io/openpak/x360-msgserver:latest
AutoUpdate=registry
Network=openpak.network
IP=10.89.2.204
Environment=X360_MSGSERVER_ADDR=:10002
EnvironmentFile=%h/openpak/deploy/x360-gateway-key.env
Environment=X360_MSGSERVER_TITLES=/titles.json
Volume=%h/openpak/deploy/x360-msgserver-titles.json:/titles.json:ro
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
UserNS=keep-id:uid=100,gid=101

[Service]
Restart=always

[Install]
WantedBy=default.target
